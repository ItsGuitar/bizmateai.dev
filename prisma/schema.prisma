datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  businessName  String    @default("Ploy Select Co., Ltd.")
  role                   String    @default("OWNER")
  lastScannerAnalysisAt  DateTime?
  createdAt              DateTime  @default(now())

  chats         ChatSession[]
  inboxItems    InboxApproval[]
  auditLogs     AuditLog[]
  bankConnections UserBankConnection[]
  whatIfScenarios WhatIfScenario[]
  businessProfile BusinessProfile?
}

model BusinessProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  businessName        String
  juristicId          String?
  businessType        String? // Company limited | Partnership | Sole proprietorship | Other
  tradingSince        Int?    // Year, e.g. 2021
  whatYouSell         String?
  whereYouSell        String[] @default([]) // Online marketplaces, Own shop/stall, Wholesale, Own website, Export
  mainSupplierCountry String?
  monthlySalesRange   String? // Approximate bucket, e.g. "฿100,000 - ฿500,000"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WhatIfScenario {
  id          String   @id @default(cuid())
  userId      String
  bankId      String   @default("kbank") // kbank | scb | bbl | personal
  name        String
  type        String   @default("OUTFLOW") // INFLOW | OUTFLOW
  weekIndex   Int      // 0 to 12 (corresponding to W1 to W13)
  weekLabel   String   // W1 to W13
  amount      Float
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, bankId])
}

model ChatSession {
  id          String        @id @default(cuid())
  userId      String
  title       String
  createdAt   DateTime      @default(now())
  messages    ChatMessage[]
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id          String       @id @default(cuid())
  sessionId   String
  senderType  String       // USER | AGENT
  agentId     String?      // health | cash | funding | collections | true-cost | trust
  content     String
  reasoning   String?      // Glass-box deliberation trace
  actionRoute String?      // Target actionable view route
  createdAt   DateTime     @default(now())
  session     ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model InboxApproval {
  id              String   @id @default(cuid())
  userId          String
  agentId         String   // Originating Agent
  title           String
  description     String
  impact          String   // e.g. "+฿35,000 cash balance on 20 Oct"
  status          String   @default("PENDING") // PENDING | APPROVED | DECLINED
  requiresFaceId  Boolean  @default(false)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserBankConnection {
  id          String   @id @default(cuid())
  userId      String
  bankId      String   // kbank | scb | bbl | personal
  bankName    String
  companyName String
  isEnabled   Boolean  @default(true)
  linkedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bankId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  agentId     String
  action      String
  status      String   // DONE | SENT | FLAGGED | BLOCKED
  timestamp   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
